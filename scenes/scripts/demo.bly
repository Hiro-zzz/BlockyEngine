// The physics spike's contraption -- built from script instead of from C++.
//
// Everything below runs without a rebuild. Change a number, run the scene
// again, and the world is different; with a viewport in front of it, saving
// this file would rebuild the contraption while the world stayed up.

let ground = 20

fn build_ground() {
    fillbox(vec(-ground, -2, -ground), vec(ground, -1, ground), stone)
    fillbox(vec(-ground, 0, -ground), vec(ground, 0, ground), grass_block)

    // A step, so that not every landing is the same event.
    fillbox(vec(-9, 1, -3), vec(-6, 1, 0), cobblestone)

    // A gantry to hang things from.
    fillbox(vec(6, 1, 1), vec(6, 6, 1), oak_log)
    fillbox(vec(0, 6, 1), vec(6, 6, 1), oak_log)

    // A mast for the driven wheel. Tall enough that the blade sweeps clear
    // of it -- a wheel spinning through its own post is a short film about
    // why contacts and joints have to agree.
    fillbox(vec(-7, 1, 2), vec(-7, 6, 2), oak_log)
}

// The loop that would have been four copied lines in C++.
fn build_stack(base, count) {
    let made = []
    for i in range(count) {
        push(made, spawn("crate", base + vec(0, i * 1.02, 0)))
    }
    return made
}

fn hang_on_rope(anchor, drop, length) {
    let crate = spawn("crate", anchor - vec(0, drop, 0), vec(0.72, 0.85, 1.0))
    setvelocity(crate, vec(1.4, 0, 0))
    rope(crate, nil, pos(crate), anchor, length)
    return crate
}

fn hang_on_hinge(anchor, drop) {
    let sign = spawn("plank", anchor - vec(0, drop, 0))
    turn(sign, vec(0, 0, 1), 90)
    setvelocity(sign, vec(2.2, 0, 0))

    // Damped, or it is a frictionless pendulum and swings for ever. That is
    // correct physics and the wrong thing for a sign.
    damp(hinge(sign, nil, anchor, vec(0, 0, 1)), 30)
    return sign
}

// A driven axle: the thing that turns a pile of welded props into a machine.
fn build_wheel(anchor) {
    let wheel = spawn("plank", anchor, vec(0.9, 0.95, 1.0))
    let axle = hinge(wheel, nil, anchor, vec(0, 0, 1))
    motor(axle, 3.5, 600)
    return wheel
}

// A piston is not a joint kind. It is a rod whose length someone drives, and
// `on tick` is the someone.
fn build_lift(anchor, drop) {
    let cage = spawn("crate", anchor - vec(0, drop, 0), vec(1.0, 0.9, 0.75))
    let ram = rod(cage, nil, pos(cage), anchor, drop)
    damp(ram, 500)
    return ram
}

fn weld_arm_to_crate(at) {
    let base = spawn("crate", at)
    let arm = spawn("plank", at + vec(0, 0.7, 0), vec(0.85, 0.9, 1.0))
    setspin(base, vec(0, 0.6, 0))
    setspin(arm, vec(0, 0.6, 0))
    weld(arm, base, at + vec(0, 0.4, 0))
    return arm
}

let stack = []
let lift = nil
let walker = nil

on ready {
    build_ground()

    stack = build_stack(vec(-3, 1.55, -1), 3)
    hang_on_rope(vec(0.8, 5.9, 1.5), 1.3, 2.2)
    hang_on_hinge(vec(4.6, 5.9, 1.5), 1.1)
    weld_arm_to_crate(vec(8.2, 5.0, -1.4))
    spawn("ell", vec(-7.4, 6.4, -1.6))

    build_wheel(vec(-6.5, 8.4, 2.5))
    lift = build_lift(vec(2.7, 5.9, 1.5), 1.6)

    // Characters. Feet sit at the entity's own origin, so a figure standing
    // on ground whose top is y = 1 goes at y = 1.
    spawnentity("player", vec(-1.2, 1, -4.5), 155)
    walker = spawnentity("player", vec(4.2, 1, -3.2), -25)

    print("built " + bodycount() + " bodies, " + len(stack) + " of them in a stack")
}

let elapsed = 0
let placed = false

on tick(dt) {
    elapsed = elapsed + dt

    // The piston, driven from here. Nothing in the engine knows what a
    // hydraulic is -- this line is the whole of it.
    if lift != nil {
        setlength(lift, 1.6 + sin(elapsed * 1.1) * 0.9)
    }

    // A character posed from script, every frame. Nothing is simulating it --
    // an entity is not a body, it is a thing someone bends.
    if walker != nil {
        stride(walker, sin(elapsed * 3.2) * 34)
        pose(walker, "head", 0, sin(elapsed * 1.3) * 28, 0)
    }

    // A script driving the world over time, not just building it once.
    if elapsed > 1.2 and not placed {
        placed = true

        // On top of the third crate, not above it. A stack settles about five
        // millimetres into itself per layer, so "one metre up from the last
        // one" is measurably wrong by the third -- ask the world instead.
        let top = stack[len(stack) - 1]
        push(stack, spawn("crate", pos(top) + vec(0, 1.0, 0)))
        print("placed a fourth crate on the stack at t = " + round(elapsed * 100) / 100)
    }
}
